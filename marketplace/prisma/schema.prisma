generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations. With Supabase/Neon, DATABASE_URL is the
  // pooled URL and DIRECT_URL the direct one; locally both can be the same.
  directUrl = env("DIRECT_URL")
}

// A restaurant, bakery, butcher, etc. selling through the marketplace.
model Vendor {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  tagline     String
  story       String
  city        String
  state       String
  originZip   String
  emoji       String @default("🍽️")
  // Kosher certifying agency (hechsher), e.g. "OU", "OK", "Star-K", "CRC".
  certification String @default("")
  accentColor String @default("#f97316")

  // Whether the shared local courier picks up from this vendor. Local fees are platform-wide (src/lib/config.ts).
  courierPickup     Boolean @default(false)
  shipsNationwide   Boolean @default(true)
  overnightShipFee  Int    @default(1999) // cents
  twoDayShipFee     Int?   @default(999)  // cents; null = no 2-day option. Shelf-stable orders only.
  freeShippingMin   Int?   // cents; order subtotal at which delivery is free
  commissionRate    Float  @default(0.2) // platform take rate
  // Pre-Yom Tov priority delivery, per shipping speed (cents).
  priorityOvernightFee Int @default(1499)
  priorityTwoDayFee    Int @default(999)

  // Stripe Connect (Express) account that receives this vendor's payouts.
  stripeAccountId      String?
  stripePayoutsEnabled Boolean @default(false)

  active    Boolean  @default(true)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())

  products     Product[]
  vendorOrders VendorOrder[]
  users        User[]
}

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  vendorId    String
  vendor      Vendor  @relation(fields: [vendorId], references: [id])
  name        String
  description String
  price       Int // cents
  category    String
  serves      String?
  kosherType  String  @default("pareve") // meat | dairy | pareve
  kosherForPassover Boolean @default(false)
  // Comma-separated keys from KOSHER_LABELS in src/lib/kosher.ts, e.g. "glatt,bishul-yisroel".
  labels      String  @default("")
  emoji       String  @default("🍽️")
  imageUrl    String?
  perishable  Boolean @default(true)
  active      Boolean @default(true)
  featured    Boolean @default(false)
  createdAt   DateTime @default(now())

  orderItems OrderItem[]
  images     ProductImage[]
}

// What the customer places and pays for. Split into one VendorOrder per vendor.
model Order {
  id            String   @id @default(cuid())
  number        String   @unique
  email         String
  name          String
  phone         String?
  address1      String
  address2      String?
  city          String
  state         String
  zip           String
  giftMessage   String?
  subtotal      Int
  shippingTotal Int
  total         Int
  paymentStatus String   @default("pending") // pending | paid | expired ("paid" = money collected, even if later partly refunded)
  refundedAmount Int     @default(0) // cents refunded so far across cancelled shipments
  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  createdAt     DateTime @default(now())

  vendorOrders VendorOrder[]
}

model VendorOrder {
  id               String    @id @default(cuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id])
  vendorId         String
  vendor           Vendor    @relation(fields: [vendorId], references: [id])
  method           String // local_delivery | overnight_shipping | two_day_shipping
  shipDate         DateTime // local delivery: the day it goes out
  deliveryDate     DateTime
  subtotal         Int
  shippingFee      Int
  commission       Int
  priority         Boolean   @default(false)
  priorityFee      Int       @default(0) // cents; part of shippingFee
  holidayName      String?
  // Set when a late priority order's priority fee is refunded (our on-time guarantee).
  priorityRefundedAt     DateTime?
  stripePriorityRefundId String?
  // How much of this vendor's payout has already been pulled back from their Stripe account.
  payoutReversed   Int       @default(0)
  stripeTransferId String?
  vendorPayout     Int
  status           String    @default("pending") // pending | preparing | shipped | out_for_delivery | delivered | cancelled
  trackingNumber   String?
  carrier          String?
  // Set when the vendor (or an admin) cancels this shipment and the customer is refunded for it.
  cancelledAt          DateTime?
  cancelledBy          String? // email of who cancelled
  cancelReason         String?
  refundAmount         Int? // cents: this shipment's items + delivery
  stripeRefundId       String?
  stripeTransferReversalId String?
  updatedAt        DateTime  @updatedAt

  items OrderItem[]
}

model OrderItem {
  id            String      @id @default(cuid())
  vendorOrderId String
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id])
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  name          String
  unitPrice     Int
  quantity      Int
}

// Someone who can sign in: an admin, or a vendor's staff member.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String // admin | vendor
  vendorId     String? // set for vendor users
  vendor       Vendor?  @relation(fields: [vendorId], references: [id])
  createdAt    DateTime @default(now())

  sessions Session[]
}

model Session {
  id        String   @id @default(cuid())
  // SHA-256 of the cookie token, so a database leak doesn't expose live sessions.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Every notification email, kept so each is sent at most once and admins can review them.
model EmailLog {
  id        String   @id @default(cuid())
  // e.g. "order-confirmation:<orderId>"; unique so retries never send twice.
  key       String   @unique
  to        String
  subject   String
  html      String
  text      String
  status    String // sent | outbox (no provider configured) | failed
  error     String?
  createdAt DateTime @default(now())
}

// Failed sign-in attempts per email, stored in the database so the lockout
// holds even when the site runs on several servers.
model LoginThrottle {
  email       String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// Product photos, stored in the database as processed WebP (see src/lib/images.ts).
// The first by position is the main photo.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int
  width     Int
  height    Int
  large     Bytes // up to 1600px wide, for the product page
  small     Bytes // up to 600px wide, for cards and thumbnails
  createdAt DateTime @default(now())

  @@index([productId, position])
}
