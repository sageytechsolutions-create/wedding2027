# PostgreSQL. Locally: `docker compose up -d` (see docker-compose.yml).
# In production (Supabase/Neon): DATABASE_URL = pooled connection, DIRECT_URL = direct connection.
DATABASE_URL="postgresql://ll:ll@localhost:5432/locallegends"
DIRECT_URL="postgresql://ll:ll@localhost:5432/locallegends"

# Public URL of the site, no trailing slash (used in emails and Stripe redirects).
SITE_URL="http://localhost:3000"

# Where customers write for help (shown in emails and policy pages).
SUPPORT_EMAIL="support@yourdomain.com"

# Stripe. Leave blank to run checkout in demo mode (no card charged). Required in production.
# Use test keys (sk_test_…) until you're ready to go live.
STRIPE_SECRET_KEY=""
# From the webhook endpoint pointed at {SITE_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# Email via Resend (https://resend.com). Leave blank to keep emails in Admin → Emails without sending.
RESEND_API_KEY=""
# Must be an address on a domain you've verified in Resend.
EMAIL_FROM="Local Legends <orders@yourdomain.com>"
EMAIL_REPLY_TO=""

# Set to "true" to keep the site open on Shabbat/Yom Tov (local testing only; ignored in production).
STORE_ALWAYS_OPEN=""
