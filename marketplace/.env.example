# SQLite for local development. For production, switch the provider in
# prisma/schema.prisma to "postgresql" and point this at Postgres/Supabase.
DATABASE_URL="file:./dev.db"

# Public URL of the site (used for Stripe redirect links).
SITE_URL="http://localhost:3000"

# Stripe. Leave blank to run checkout in demo mode (no card charged).
# Use test keys (sk_test_…) until you're ready to go live.
STRIPE_SECRET_KEY=""
# From the webhook endpoint pointed at {SITE_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# Set to "true" to keep the site open on Shabbat/Yom Tov (local testing only).
STORE_ALWAYS_OPEN=""
